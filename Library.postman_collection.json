  },
  "item": [
    {
      "name": "Health and Docs",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('returns structured health payload', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.service).to.eql('LibraryService');",
                  "  pm.expect(json.status).to.eql('ok');",
                  "  pm.expect(json.version).to.be.a('string');",
                  "  pm.expect(new Date(json.timestamp).toString()).to.not.eql('Invalid Date');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Swagger JSON",
          "event": [
            {
