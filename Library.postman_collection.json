    {
      "name": "Suggestions",
      "description": "Set `openaiApiKey` to a valid OpenAI API key to exercise successful BYOK suggestions. If left blank, these requests verify the expected missing-key validation response.",
      "item": [
        {
          "name": "Suggest Books by Author ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const hasKey = Boolean(pm.collectionVariables.get('openaiApiKey'));",
                  "",
                  "pm.test('returns expected status for API key state', function () {",
                  "  if (hasKey) {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "  } else {",
                  "    pm.response.to.have.status(400);",
                  "  }",
                  "});",
                  "",
                  "pm.test('returns suggestions or missing-key message', function () {",
                  "  if (hasKey) {",
                  "    pm.expect(pm.response.text()).to.not.be.empty;",
                  "  } else {",
                  "    pm.expect(pm.response.text()).to.include('OpenAI API key');",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-OpenAI-API-Key",
                "value": "{{openaiApiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/library/suggestions/{{authorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "library",
                "suggestions",
                "{{authorId}}"
              ]
            }
          },
          "response": []
        },
